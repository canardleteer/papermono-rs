# Normal Rust Repository Things
/target

# papermono-rs firmware
/firmware/*/target

# Clone-local private / personalized files. Per-unit
# factory originals (NVS, RF calibration, MAC, serials) live under
# developer-data/backups/. Never commit this tree. See docs/SAFETY.md.
/developer-data/

# Leftover pre-move path. Do not use. Still ignored so a stray dump
# cannot land in git.
/backups/

# Host-check UART captures from `monitor --output`.
# Do not commit them.
/idle-embassy.log
/idle-simple.log
/idle.log

# Flash images and device dumps: these contain per-unit
# NVS, Wi-Fi RF calibration, MAC, and serial number. Never commit them. See
# docs/SAFETY.md.
*.bin
*.elf
!**/partitions.csv

# Local vendor datasheet PDFs and extracted markdown.
# Catalog is stored in:
# .agents/skills/m5stack-papermono-hardware/resources/datasheets.md
.agents/skills/m5stack-papermono-hardware/resources/datasheets/pdf/
.agents/skills/m5stack-papermono-hardware/resources/datasheets/md/
